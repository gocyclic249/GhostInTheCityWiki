export NEOCITIES_API_KEY=your-neocities-api-key
export TAVILY_API_KEY=your-tavily-api-key
export SB_USER=your-spacebattles-email
export SB_PASS=your-spacebattles-password

# SpaceBattles is behind Cloudflare, which now challenges plain HTTP clients.
# The requests-based scrapers (scrape_sidestories.py, scrape_media.py) need a
# cf_clearance cookie borrowed from a browser that already solved the challenge,
# plus that browser's exact User-Agent. Both are short-lived; re-copy when the
# scraper reports a Cloudflare challenge. See docs/spacebattles-cloudflare.md.
# export SB_USER_AGENT='Mozilla/5.0 (...) Chrome/xxx Safari/537.36'
# export SB_CF_CLEARANCE=paste-cf_clearance-cookie-value-here
# Alternatively, a full raw Cookie header (overrides SB_CF_CLEARANCE):
# export SB_COOKIE='cf_clearance=...; xf_user=...; xf_session=...'

# Optional: override chromedriver/chromium paths
# export CHROMEDRIVER_PATH=/path/to/chromedriver
# export CHROMIUM_PATH=/path/to/chromium
