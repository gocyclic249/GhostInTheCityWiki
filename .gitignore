__pycache__/
*.pyc
*.pyo
.env
scripts/debug/

# Full chapter text (copyrighted content)
chapters/
sidestories/

# Images / media (fan art, screenshots)
wiki/build/media/
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.svg
*.avif

# Encrypted media archive IS tracked (AES-256 volumes, see CLAUDE.md).
# Negated explicitly so a future *.zip rule cannot silently drop the backup.
!media-archive/
!media-archive/*.zip
